# GEMINI_API_KEY: Server-side only environment variable required for Gemini API calls.
# - In Google AI Studio: Automatically injected at runtime via Settings > Secrets.
# - On Vercel: Add GEMINI_API_KEY in Vercel Project Settings > Environment Variables.
# NEVER prefix with VITE_ and NEVER commit real keys to GitHub.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
